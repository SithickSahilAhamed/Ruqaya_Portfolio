rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for Courses page.
    // Writes are gated by the client Admin password (VITE_ADMIN_PASSWORD)
    // until Firebase Authentication (email/password) is enabled in Console,
    // after which tighten to: allow write: if request.auth != null;
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
