rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public Courses page can read; Admin writes require Firebase Auth.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
