rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for course images.
    // Writes allowed for image uploads under courses/ (client Admin password gate).
    // After enabling Firebase Auth email/password, tighten write to request.auth != null.
    match /courses/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
  }
}
